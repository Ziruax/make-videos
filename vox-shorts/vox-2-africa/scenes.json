  "vo": [
    { "beat": "s1", "text": "In 1880, almost all of Africa was ruled by Africans.", "start": 0.5, "end": 4.0 },
    { "beat": "s2", "text": "Then fourteen European powers sat down in Berlin — and divided the continent.", "start": 5.0, "end": 9.4 },
    { "beat": "s3", "text": "No African was in the room.", "start": 10.4, "end": 13.2 },
    { "beat": "s4", "text": "Drawn with rulers, thousands of kilometres from the people who lived there.", "start": 14.2, "end": 19.4 },
    { "beat": "s4", "text": "Forty-four percent of the borders are straight lines.", "start": 20.2, "end": 23.2 },
    { "beat": "s5", "text": "By 1914, ninety percent of Africa was European.", "start": 24.2, "end": 27.2 },
    { "beat": "s5", "text": "Only Ethiopia and Liberia remained free.", "start": 27.8, "end": 30.6 },
    { "beat": "s6", "text": "A hundred and thirty years on, the lines are still here.", "start": 31.6, "end": 35.6 }
  ],
