# Copy to .env (repo root) and fill in what you use.
# NOTE: with Edge TTS as the default voice (tools/gen_voice_edge.py), NO keys are
# needed to build TSX shorts, map films, motion-graphics reels or minimal reels.

# Microsoft Edge TTS — voice is chosen by NAME on the command line
# (python tools/gen_voice_edge.py --list-voices), no key required.

# ElevenLabs — OPTIONAL: emotion-tagged voice (tools/gen_voice.py),
# sound-effect generation (tools/gen_sfx.py) and music beds (tools/gen_music.py).
ELEVENLABS_API_KEY=

# Google Gemini — OPTIONAL: image generation (tools/gen_image.py), e.g. story frames.
GEMINI_API_KEY=

# fal.ai — OPTIONAL, generative video clips (tools/gen_clip.py).
FAL_KEY=
